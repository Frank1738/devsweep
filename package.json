{
  "name": "devsweep",
  "version": "0.0.0",
  "private": true,
  "description": "Scan your dev setup and repos for the supply-chain and credential risks that infostealers exploit.",
  "license": "MIT",
  "keywords": [
    "security",
    "supply-chain",
    "github-actions",
    "secrets",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frank1738/devsweep.git"
  },
  "type": "module",
  "bin": {
    "devsweep": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs"
  },
  "dependencies": {
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
