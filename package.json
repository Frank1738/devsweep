{
  "name": "@frank1738/devsweep",
  "version": "0.1.1",
  "description": "Scan your dev setup and repos for the supply-chain and credential risks that infostealers exploit.",
  "license": "MIT",
  "keywords": [
    "security",
    "supply-chain",
    "supply-chain-security",
    "github-actions",
    "github-actions-security",
    "sarif",
    "code-scanning",
    "cli"
  ],
  "homepage": "https://github.com/Frank1738/devsweep#readme",
  "bugs": {
    "url": "https://github.com/Frank1738/devsweep/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frank1738/devsweep.git"
  },
  "type": "module",
  "bin": {
    "devsweep": "dist/devsweep.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/devsweep.mjs",
    "dist/index.mjs",
    "dist/**/*.d.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "rolldown": "1.2.16",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
