        {
          "ruleId": "workflow/unpinned-action",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Third-party action \"example-org/create-release\" is pinned to \"v2\", a tag or branch its owner can move."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18,
