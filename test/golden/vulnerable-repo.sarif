        {
          "ruleId": "workflow/unpinned-action",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Container image \"docker://alpine:3.20\" is not pinned to a digest."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 17,
                  "startColumn": 15,
                  "endLine": 17,
                  "endColumn": 35
                }
              }
